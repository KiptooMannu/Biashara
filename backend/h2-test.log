       sum(s.total - coalesce(s.cost_of_goods, 0)) as secondary,
       count(*) as count
from sales s
where s.tenant_id = ? and s.deleted = false
  and s.status = 'COMPLETED'
  and s.sale_date >= ?
group by to_char(s.sale_date, 'YYYY-MM-DD')
order by bucket asc
